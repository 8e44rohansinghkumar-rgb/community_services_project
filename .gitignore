# Dependencies
node_modules/
.pnp
.pnp.js

# Secrets — NEVER commit real environment files.
# Only .env.example (placeholder values) belongs in version control.
.env
.env.*
!.env.example
*.pem
*.key

# Build output
dist/
build/
out/
*.tsbuildinfo

# Uploaded user content (stored outside the web root, never in git)
var/
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Caches
.cache/
.vite/
.eslintcache

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Sandbox artefacts
.npm/
.sudo_as_admin_successful
