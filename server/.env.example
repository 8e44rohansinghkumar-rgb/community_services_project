# ---------------------------------------------------------------------------
# Smart Civic Issue Reporting System — server configuration
# Copy to .env and replace every secret. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Public URL of the frontend (used in notification links).
APP_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://civic:civic_dev_password@127.0.0.1:5432/civic
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- CORS ------------------------------------------------------------------
# Explicit allowlist, comma separated. Wildcards are rejected in production.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Auth secrets ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef0123456789abcdef
COOKIE_SECRET=dev-only-cookie-secret-change-me-fedcba9876543210fedcba987654
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Uploads ---------------------------------------------------------------
# Must live OUTSIDE any statically served directory.
UPLOAD_DIR=./var/uploads
MAX_FILE_SIZE=5242880
MAX_FILES_PER_ISSUE=5

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Duplicate detection ---------------------------------------------------
DUPLICATE_RADIUS_METERS=150
DUPLICATE_WINDOW_DAYS=7

# --- Email (optional; console notifier used when unset) --------------------
#EMAIL_HOST=smtp.example.org
#EMAIL_PORT=587
#EMAIL_USER=
#EMAIL_PASSWORD=
#EMAIL_FROM=no-reply@civic.example.org

# --- AI classifier (optional; app is fully functional without it) ----------
#AI_CLASSIFIER_URL=http://localhost:8000/classify
